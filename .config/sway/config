#@:--------:%
#   RICING
#@:--------:%

# gaps and borders

gaps inner 8px
gaps outer 8px
default_border pixel 1px
default_floating_border pixel 1px

# border colours
#                       border  bg      text    ind     child border
client.focused          #b66395 #141216 #d8cab8 #b66395 #b66395
client.focused_inactive #5a5da0 #141216 #d8cab8 #5a5da0 #5a5da0
client.unfocused        #5a5da0 #141216 #d8cab8 #5a5da0 #5a5da0
client.urgent           #ff4f00 #141216 #d8cab8 #ff4f00 #ff4f00
client.placeholder      #5a5da0 #141216 #d8cab8 #5a5da0 #5a5da0

# gtk

set $gnome-schema org.gnome.desktop.interface
exec_always {
    gsettings set $gnome-schema cursor-blink false
}

include /etc/sway/config.d/*
include touchpad
